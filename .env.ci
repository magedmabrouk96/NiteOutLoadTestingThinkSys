# CI / GitHub Actions profile.
# VUS and TEST_DURATION are overridden by the workflow inputs at runtime.
TEST_PROFILE=load
VUS=50
TEST_DURATION=7m
SESSION_SECONDS=60
HEARTBEAT_SECONDS=15
HEARTBEAT_JITTER_SECONDS=2
ENABLE_RUNTIME_WRITES=true
RUN_RARE_MOBILE_WRITES_ONCE=false
LOAD_GENERATOR=ci
ALLOW_HIGH_LOCAL_LOAD=false
ALLOW_SHARED_WRITE_IDENTITY=true
REPORT_HTML=true
GRAFANA_OUTPUT=false
