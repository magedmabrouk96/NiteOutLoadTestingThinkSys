# One controlled execution that exercises the validated Mobile onboarding/profile writes once,
# then runs the complete user session. Email subscription is intentionally excluded by client.
TEST_PROFILE=coverage
VUS=1
TEST_DURATION=2m
SESSION_SECONDS=20
HEARTBEAT_SECONDS=15
ENABLE_RUNTIME_WRITES=true
RUN_RARE_MOBILE_WRITES_ONCE=true
LOAD_GENERATOR=local
