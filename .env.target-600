# Client target: 600 concurrent sessions across the 3 configured venues => 200 per venue.
TEST_PROFILE=load
VUS=600
TEST_DURATION=30m
SESSION_SECONDS=120
HEARTBEAT_SECONDS=15
ENABLE_RUNTIME_WRITES=true
RUN_RARE_MOBILE_WRITES_ONCE=false
LOAD_GENERATOR=cloud
ALLOW_HIGH_LOCAL_LOAD=false
# With only K6_FIREBASE_TOKEN all sessions authenticate as one test identity.
# For a production-representative 600-user write test, K6_TOKEN_FILE should contain multiple test-user tokens.
ALLOW_SHARED_WRITE_IDENTITY=true
